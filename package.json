{
  "name": "school-recommender",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter client dev\" \"pnpm --filter server dev\"",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm --filter client build && pnpm --filter server build",
    "deploy:build": "powershell -ExecutionPolicy Bypass -File deploy/build.ps1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "eslint": "^10.2.0"
  }
}
