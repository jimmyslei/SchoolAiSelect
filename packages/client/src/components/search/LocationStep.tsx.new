import { useState } from 'react';
import { motion } from 'framer-motion';
import { MapPin, Loader2, AlertCircle, Navigation, Check } from 'lucide-react';
import type { GeoLocationStatus } from '@/types/school';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Card } from '@/components/ui/card';
import { Separator } from '@/components/ui/separator';

interface LocationStepProps {
  status: GeoLocationStatus;
  error: string | null;
  onRetry: () => void;
  onManualInput: (address: string) => void;
}

export function LocationStep({ status, error, onRetry, onManualInput }: LocationStepProps) {
  const [manualAddress, setManualAddress] = useState('');

  return (
    <motion.div
      initial={{ opacity: 0, y: 20 }}
      animate={{ opacity: 1, y: 0 }}
      className="flex flex-col items-center gap-6 py-8 px-4"
    >
      {/* 定位动画 */}
      {status === 'requesting' && (
        <>
          <div className="relative">
            <motion.div
              animate={{ scale: [1, 1.5, 1], opacity: [0.4, 0, 0.4] }}
              transition={{ duration: 2, repeat: Infinity }}
              className="absolute inset-0 w-20 h-20 rounded-full bg-warm-300/30"
            />
            <motion.div
              animate={{ scale: [1, 1.3, 1], opacity: [0.6, 0, 0.6] }}
              transition={{ duration: 2, repeat: Infinity, delay: 0.3 }}
              className="absolute inset-0 w-20 h-20 rounded-full bg-warm-400/20"
            />
            <div className="relative w-20 h-20 rounded-full bg-warm-100 flex items-center justify-center">
              <Navigation className="w-8 h-8 text-primary animate-pulse" />
            </div>
          </div>
          <div className="text-center">
            <p className="text-lg font-semibold text-foreground font-display">正在获取您的位置...</p>
            <p className="text-sm text-muted-foreground mt-1 flex items-center gap-1.5 justify-center">
              <Loader2 className="w-3.5 h-3.5 animate-spin" />
              请允许浏览器访问您的位置信息
            </p>
          </div>
        </>
      )}

      {/* 定位失败 */}
      {(status === 'denied' || status === 'error') && (
        <>
          <div className="w-16 h-16 rounded-full bg-peach-100 flex items-center justify-center">
            <AlertCircle className="w-8 h-8 text-peach-500" />
          </div>

          <div className="text-center">
            <p className="text-lg font-semibold text-foreground font-display mb-1">定位未成功</p>
            <p className="text-sm text-muted-foreground">{error}</p>
          </div>

          <Card className="w-full max-w-sm p-5 space-y-4">
            <Button variant="outline" className="w-full" onClick={onRetry}>
              重试定位
            </Button>

            <div className="flex items-center gap-3">
              <Separator className="flex-1" />
              <span className="text-xs text-muted-foreground whitespace-nowrap">或手动输入地址</span>
              <Separator className="flex-1" />
            </div>

            <div className="flex gap-2">
              <div className="flex-1 relative">
                <MapPin className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground" />
                <Input
                  value={manualAddress}
                  onChange={(e) => setManualAddress(e.target.value)}
                  placeholder="请输入地址，如：北京市海淀区..."
                  className="pl-9"
                  onKeyDown={(e) => {
                    if (e.key === 'Enter' && manualAddress.trim()) {
                      onManualInput(manualAddress.trim());
                    }
                  }}
                />
              </div>
              <Button
                onClick={() => manualAddress.trim() && onManualInput(manualAddress.trim())}
                disabled={!manualAddress.trim()}
              >
                确定
              </Button>
            </div>
          </Card>
        </>
      )}

      {/* 定位成功 */}
      {status === 'success' && (
        <>
          <motion.div
            initial={{ scale: 0 }}
            animate={{ scale: 1 }}
            transition={{ type: 'spring', bounce: 0.5 }}
            className="w-16 h-16 rounded-full bg-sage-100 flex items-center justify-center"
          >
            <Check className="w-8 h-8 text-sage-500" />
          </motion.div>
          <p className="text-lg font-semibold text-foreground font-display">位置获取成功！</p>
          <p className="text-sm text-muted-foreground">正在搜索附近学校...</p>
        </>
      )}
    </motion.div>
  );
}
