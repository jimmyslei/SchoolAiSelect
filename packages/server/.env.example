# 高德地图 Web服务API Key
AMAP_API_KEY=your_amap_api_key_here

# 高德地图服务端签名密钥
SK=your_amap_sk_here

# 阿里百炼平台 DashScope API Key
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# DashScope OpenAI 兼容端点
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 大模型 API 风格：chat（默认）或 responses。
# 当供应商要求直接调用 /responses，例如 https://api.routin.ai/plan/v1/responses 时：
# 1. 可将 DASHSCOPE_BASE_URL 直接写成完整的 /responses 地址，系统会自动去掉末尾 /responses 并切换到 Responses API。
# 2. 或将 DASHSCOPE_BASE_URL 写为基础地址，再显式设置 DASHSCOPE_API_STYLE=responses。
# DASHSCOPE_API_STYLE=responses

# DashScope 模型名
DASHSCOPE_MODEL=qwen3.6-plus

# 服务器端口
PORT=3001

# SQLite 数据库路径（可选，默认发布目录 data/school-recommender.db）
# DATABASE_PATH=data/school-recommender.db

# 邮箱验证码 SMTP 配置
SMTP_HOST="smtp.qq.com"
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME="jjmmyy1@qq.com"
SMTP_PASSWORD="yactfgbiitrubbie"
SMTP_FROM_EMAIL="jjmmyy1@qq.com"
SMTP_FROM_NAME="学校推荐系统"

# skill 执行命令
NODE_COMMAND=node
PYTHON_COMMAND=python

# 单次 skill 调用超时时间（秒）
SKILL_TIMEOUT_SECONDS=90
