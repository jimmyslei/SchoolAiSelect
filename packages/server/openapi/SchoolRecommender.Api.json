  "components": {
    "schemas": {
      "AnonymousTypeOfstringAndDateTimeOffsetAndAnonymousTypeOfstringAndintAndintAndintAndintAndstringAndbooleanAndAnonymousTypeOfstringAndstringAndintAnddouble": {
        "required": [
          "status",
          "timestamp",
          "configuration",
          "environment"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": [
              "null",
              "string"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "configuration": {
            "$ref": "#/components/schemas/AnonymousTypeOfstringAndintAndintAndintAndintAndstringAndboolean"
          },
          "environment": {
            "$ref": "#/components/schemas/AnonymousTypeOfstringAndstringAndintAnddouble"
          }
        }
      },
      "AnonymousTypeOfstringAndintAndintAndintAndintAndstringAndboolean": {
        "required": [
          "model",
          "dashScopeNetworkTimeoutSeconds",
          "maxConcurrency",
          "amapPageSize",
          "skillTimeoutSeconds",
          "databasePath",
          "smtpConfigured"
        ],
        "type": "object",
        "properties": {
          "model": {
            "type": [
              "null",
              "string"
            ]
          },
          "dashScopeNetworkTimeoutSeconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "maxConcurrency": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "amapPageSize": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "skillTimeoutSeconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "databasePath": {
            "type": [
              "null",
              "string"
            ]
          },
          "smtpConfigured": {
            "type": "boolean"
          }
        }
      },
      "AnonymousTypeOfstringAndstringAndintAnddouble": {
        "required": [
          "dotnetVersion",
          "osDescription",
          "processorCount",
          "workingSetMb"
        ],
        "type": "object",
        "properties": {
          "dotnetVersion": {
            "type": [
              "null",
              "string"
            ]
          },
          "osDescription": {
            "type": [
              "null",
              "string"
            ]
          },
          "processorCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "workingSetMb": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "ApiResponseOfAuthPayload": {
        "required": [
          "success",
          "data"
        ],
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AuthPayload"
              }
            ]
          },
          "message": {
            "type": [
              "null",
              "string"
            ]
          },
          "fallbackToBrowser": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "ApiResponseOfGeoLocationResponse": {
        "required": [
          "success",
          "data"
        ],
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/GeoLocationResponse"
              }
            ]
          },
          "message": {
            "type": [
              "null",
              "string"
            ]
          },
          "fallbackToBrowser": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "ApiResponseOfIpLocationResponse": {
        "required": [
          "success",
          "data"
        ],
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/IpLocationResponse"
              }
            ]
          },
          "message": {
            "type": [
              "null",
              "string"
            ]
          },
          "fallbackToBrowser": {
            "type": "boolean",
            "default": false
          }
